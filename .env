# ==============================================================================
# Viral Shorts Generator - Environment Configuration
# Copy this file to ".env" and fill in your real values.
# NEVER commit your real ".env" file to version control.
# ==============================================================================

# ---------------------------------------------------------------------------
# LLM PROVIDER SELECTION
# Choose which LLM powers highlight detection: "openai" or "anthropic"
# ---------------------------------------------------------------------------
LLM_PROVIDER=openai

OPENAI_API_KEY=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
OPENAI_MODEL=gpt-4o

ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
ANTHROPIC_MODEL=claude-sonnet-4-6

# ---------------------------------------------------------------------------
# TRANSCRIPTION BACKEND
# Choose "whisper" (local, free, needs GPU/CPU time) or "deepgram" (cloud API)
# ---------------------------------------------------------------------------
TRANSCRIBER_BACKEND=whisper
WHISPER_MODEL_SIZE=base          # tiny | base | small | medium | large-v3
DEEPGRAM_API_KEY=dg_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ---------------------------------------------------------------------------
# HIGHLIGHT EXTRACTION SETTINGS
# ---------------------------------------------------------------------------
MIN_CLIP_DURATION_SECONDS=30
MAX_CLIP_DURATION_SECONDS=60
NUM_HIGHLIGHTS_TO_EXTRACT=5
MIN_VIRAL_SCORE=60               # discard LLM candidates scoring below this

# ---------------------------------------------------------------------------
# OUTPUT / CROP SETTINGS
# ---------------------------------------------------------------------------
OUTPUT_WIDTH=1080
OUTPUT_HEIGHT=1920
OUTPUT_FPS=30
CROP_SMOOTHING_WINDOW=15         # frames used to smooth crop-box jitter
ENABLE_SPLIT_SCREEN=true         # auto split-screen when 2 speakers detected

# ---------------------------------------------------------------------------
# CAPTION STYLING (Hormozi-style word-by-word captions)
# ---------------------------------------------------------------------------
CAPTION_FONT_PATH=assets/fonts/Montserrat-ExtraBold.ttf
CAPTION_FONT_SIZE=90
CAPTION_COLOR=#FFFFFF
CAPTION_HIGHLIGHT_COLOR=#FFFC00
CAPTION_STROKE_COLOR=#000000
CAPTION_STROKE_WIDTH=4
CAPTION_POSITION=center_bottom   # top | center | center_bottom | bottom
CAPTION_ANIMATION=pop            # pop | bounce | fade

# ---------------------------------------------------------------------------
# VIRAL ENHANCEMENTS
# ---------------------------------------------------------------------------
ENABLE_SFX=true
SFX_DIR=assets/sfx
ENABLE_ZOOM_EFFECT=true
ZOOM_INTERVAL_MIN_SECONDS=3
ZOOM_INTERVAL_MAX_SECONDS=5
ZOOM_INTENSITY=1.08               # scale factor applied during zoom pulses

ENABLE_BACKGROUND_MUSIC=true
MUSIC_DIR=assets/music
MUSIC_VOLUME_DB=-22               # music volume relative to speech (ducked)
SPEECH_DUCK_THRESHOLD_DB=-35

# ---------------------------------------------------------------------------
# PATHS
# ---------------------------------------------------------------------------
TEMP_DIR=temp
OUTPUT_DIR=output

# ---------------------------------------------------------------------------
# LOGGING
# ---------------------------------------------------------------------------
LOG_LEVEL=INFO                    # DEBUG | INFO | WARNING | ERROR
